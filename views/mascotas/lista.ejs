
<section class="seccion-mascotas">

  <div class="encabezado-seccion">
    <div>
      <span class="etiqueta">🐾 Nuestros amigos</span>
      <h1>Mascotas en adopción</h1>
      <p>
        Conocé a nuestros amigos de cuatro patas
        y descubrí sus historias.
      </p>
    </div>

    <a href="/mascotas/nueva" class="boton boton-principal">
      + Agregar mascota
    </a>
  </div>

  <% if (mascotas.length === 0) { %>

    <div class="estado-vacio">
      <span aria-hidden="true">🐾</span>
      <h2>Todavía no hay mascotas registradas</h2>
      <p>
        Podés agregar la primera mascota
        utilizando nuestro formulario.
      </p>

      <a href="/mascotas/nueva" class="boton boton-principal">
        Agregar mascota
      </a>
    </div>

  <% } else { %>

    <div class="grilla-mascotas">

      <% mascotas.forEach((mascota) => { %>

        <article class="tarjeta-mascota">

          <div class="tarjeta-imagen">
            <img
              src="<%= mascota.imagen %>"
              alt="Imagen de <%= mascota.nombre %>"
              loading="lazy"
            >
          </div>

          <div class="tarjeta-contenido">

            <span class="estado-mascota">
              <%= mascota.estado %>
            </span>

            <h2><%= mascota.nombre %></h2>

            <p>
              <strong>Especie:</strong>
              <%= mascota.especie %>
            </p>

            <p>
              <strong>Edad:</strong>
              <%= mascota.edad %>
              <% if (mascota.edad === 1) { %>
                año
              <% } else { %>
                años
              <% } %>
            </p>

            <a
              href="/mascotas/<%= mascota.id %>"
              class="boton boton-secundario"
            >
              Ver detalles
            </a>

          </div>
        </article>

      <% }); %>

    </div>

  <% } %>

</section>
