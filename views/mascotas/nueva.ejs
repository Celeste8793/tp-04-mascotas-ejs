
<section class="seccion-formulario">

  <div class="encabezado-formulario">
    <span class="etiqueta">🐾 Sumá una nueva historia</span>

    <h1>Registrar una mascota</h1>

    <p>
      Completá el formulario para agregar una mascota
      a nuestro catálogo de Huellitas.
    </p>
  </div>

  <% if (error) { %>
    <div class="mensaje-error" role="alert">
      <strong>Revisá los datos:</strong>
      <%= error %>
    </div>
  <% } %>

  <form action="/mascotas" method="POST" class="formulario-mascota">

    <div class="grupo-formulario">
      <label for="nombre">Nombre de la mascota</label>

      <input
        type="text"
        id="nombre"
        name="nombre"
        value="<%= valores.nombre || '' %>"
        placeholder="Ejemplo: Luna"
        required
      >
    </div>

    <div class="grupo-formulario">
      <label for="especie">Especie</label>

      <input
        type="text"
        id="especie"
        name="especie"
        value="<%= valores.especie || '' %>"
        placeholder="Ejemplo: Perro o Gato"
        required
      >
    </div>

    <div class="grupo-formulario">
      <label for="edad">Edad (en años)</label>

      <input
        type="number"
        id="edad"
        name="edad"
        min="0"
        step="1"
        value="<%= valores.edad ?? '' %>"
        placeholder="Ejemplo: 2"
        required
      >
    </div>

    <div class="grupo-formulario">
      <label for="estado">Estado de adopción</label>

      <select id="estado" name="estado" required>
        <option value="">Seleccioná un estado</option>

        <option
          value="En adopción"
          <%= valores.estado === 'En adopción' ? 'selected' : '' %>
        >
          En adopción
        </option>

        <option
          value="Reservada"
          <%= valores.estado === 'Reservada' ? 'selected' : '' %>
        >
          Reservada
        </option>

        <option
          value="Adoptada"
          <%= valores.estado === 'Adoptada' ? 'selected' : '' %>
        >
          Adoptada
        </option>
      </select>
    </div>

    <div class="grupo-formulario">
      <label for="descripcion">Descripción</label>

      <textarea
        id="descripcion"
        name="descripcion"
        rows="5"
        placeholder="Contanos cómo es la mascota..."
        required
      ><%= valores.descripcion || '' %></textarea>
    </div>

    <div class="acciones-formulario">
      <button type="submit" class="boton boton-principal">
        Guardar mascota
      </button>

      <a href="/mascotas" class="boton boton-secundario">
        Cancelar
      </a>
    </div>

  </form>

</section>
